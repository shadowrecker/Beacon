// ============================================================================
// Sentiment & Churn Prediction Models
// ============================================================================

enum SentimentPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SentimentAlertType {
  TREND_DECLINE
  SPIKE_NEGATIVE
  THEME_EMERGING
  SEGMENT_RISK
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

model SentimentSnapshot {
  id              String          @id @default(cuid())
  projectId       String
  /// "all" for the project-wide snapshot; segment name otherwise.
  customerSegment String          @default("all")
  period          SentimentPeriod
  periodStart     DateTime
  periodEnd       DateTime
  overallScore    Float // -1.0 to 1.0
  volume          Int
  positiveCount   Int
  neutralCount    Int
  negativeCount   Int
  topThemes       Json? // Array of theme objects with sentiment breakdown
  riskLevel       RiskLevel
  createdAt       DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, period, periodStart, customerSegment])
  @@index([projectId, periodStart])
  @@index([riskLevel])
  @@map("sentiment_snapshots")
}

/// Labeled "AI risk assessment" in the product: an LLM judgement from
/// the listed signals, not a statistical prediction.
model ChurnPrediction {
  id                 String    @id @default(cuid())
  projectId          String
  /// JobRun that produced this assessment; a re-run replaces the previous run's rows.
  runId              String?
  customerId         String?
  customerName       String?
  segment            String?
  churnProbability   Float // 0.0 to 1.0, model-estimated risk score
  riskLevel          RiskLevel
  signals            Json // Array of contributing factors
  recommendations    Json // Array of mitigation strategies
  predictedChurnDate DateTime?
  confidence         Float
  methodology        String    @default("AI_RISK_ASSESSMENT")
  createdAt          DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([riskLevel])
  @@index([churnProbability])
  @@index([createdAt])
  @@map("churn_predictions")
}

model SentimentAlert {
  id          String             @id @default(cuid())
  projectId   String
  type        SentimentAlertType
  severity    RiskLevel
  title       String
  description String             @db.Text
  dataPoints  Json? // Supporting data
  status      AlertStatus        @default(NEW)
  createdAt   DateTime           @default(now())
  resolvedAt  DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("sentiment_alerts")
}

// ============================================================================
// Knowledge Graph Models
// ============================================================================

enum EntityType {
  PERSON
  COMPANY
  PRODUCT
  FEATURE
  CONCEPT
  PAIN_POINT
  PERSONA
  COMPETITOR
  USE_CASE
}

enum RelationType {
  MENTIONS
  RELATES_TO
  CAUSES
  SOLVES
  COMPETES_WITH
  USED_BY
  PART_OF
  SIMILAR_TO
  CONFLICTS_WITH
}

model KnowledgeEntity {
  id             String                       @id @default(cuid())
  orgId          String
  type           EntityType
  name           String
  normalizedName String // lowercase for deduplication
  aliases        String[]
  description    String?                      @db.Text
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  metadata       Json?
  confidence     Float
  firstSeenAt    DateTime                     @default(now())
  lastSeenAt     DateTime                     @default(now())
  mentionCount   Int                          @default(1)
  createdAt      DateTime                     @default(now())

  organization             Organization               @relation(fields: [orgId], references: [id], onDelete: Cascade)
  relationsFrom            KnowledgeRelation[]        @relation("source")
  relationsTo              KnowledgeRelation[]        @relation("target")
  projectNodes             KnowledgeNode_Project[]
  mergeSuggestionsAsSource KnowledgeMergeSuggestion[] @relation("mergeSource")
  mergeSuggestionsAsTarget KnowledgeMergeSuggestion[] @relation("mergeTarget")

  @@unique([orgId, normalizedName, type])
  @@index([orgId, type])
  @@map("knowledge_entities")
}

enum MergeSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Likely-duplicate entity pairs found by embedding similarity. Merges happen only
/// when a human accepts the suggestion; nothing is auto-merged.
model KnowledgeMergeSuggestion {
  id          String                @id @default(cuid())
  orgId       String
  sourceId    String
  targetId    String
  similarity  Float
  status      MergeSuggestionStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())

  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  source       KnowledgeEntity @relation("mergeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target       KnowledgeEntity @relation("mergeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
  @@index([orgId, status])
  @@map("knowledge_merge_suggestions")
}

model KnowledgeRelation {
  id                String       @id @default(cuid())
  sourceId          String
  targetId          String
  type              RelationType
  strength          Float // 0.0 to 1.0
  evidenceDocuments String[]
  evidenceChunkIds  String[]
  evidenceQuotes    Json? // Array of quote objects
  firstSeenAt       DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())
  createdAt         DateTime     @default(now())

  source KnowledgeEntity @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target KnowledgeEntity @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
  @@index([type])
  @@index([createdAt])
  @@map("knowledge_relations")
}

model KnowledgeNode_Project {
  id        String   @id @default(cuid())
  entityId  String
  projectId String
  createdAt DateTime @default(now())

  entity  KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([entityId, projectId])
  @@index([projectId])
  @@index([entityId])
  @@map("knowledge_node_projects")
}

model KnowledgeQuery {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  query     String   @db.Text
  results   Json? // Serialized graph traversal results
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  @@map("knowledge_queries")
}

// ============================================================================
// Voice-to-Insight Models
// ============================================================================

enum VoiceRecordingStatus {
  RECORDING
  UPLOADING
  TRANSCRIBING
  ANALYZING
  READY
  FAILED
}

model VoiceRecording {
  id                 String               @id @default(cuid())
  projectId          String?
  userId             String
  title              String?
  duration           Int // seconds
  /// Server-generated storage key in the application bucket. Deepgram receives a
  /// short-lived presigned GET URL for it; the client never supplies a URL.
  audioKey           String
  mimeType           String?
  transcriptText     String?              @db.Text
  /// Diarized utterances: [{speaker, start, end, text}]
  transcriptSegments Json?
  /// Document created from the transcript so voice flows into synthesis/RAG.
  documentId         String?              @unique
  status             VoiceRecordingStatus @default(RECORDING)
  errorMessage       String?              @db.Text
  recordedAt         DateTime
  processedAt        DateTime?
  deviceInfo         Json? // Device metadata from client
  createdAt          DateTime             @default(now())

  user          User           @relation("UserVoiceRecordings", fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation("ProjectVoiceRecordings", fields: [projectId], references: [id], onDelete: Cascade)
  document      Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  insight       VoiceInsight?
  quickCaptures QuickCapture[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("voice_recordings")
}

model VoiceInsight {
  id                 String   @id @default(cuid())
  recordingId        String   @unique
  summary            String   @db.Text
  keyPoints          Json? // Array of key points
  painPoints         Json? // Array of pain points
  actionItems        Json? // Array of action items
  questions          Json? // Array of questions asked
  sentimentScore     Float // -1.0 to 1.0
  themes             String[] // Array of themes
  suggestedFollowUps Json? // Array of follow-up suggestions
  claudeAnalysis     Json? // Full structured response from Claude
  createdAt          DateTime @default(now())

  recording VoiceRecording @relation(fields: [recordingId], references: [id], onDelete: Cascade)

  @@index([recordingId])
  @@index([createdAt])
  @@map("voice_insights")
}

enum QuickCaptureType {
  VOICE_NOTE
  QUICK_THOUGHT
  CALL_HIGHLIGHT
}

model QuickCapture {
  id              String           @id @default(cuid())
  userId          String
  projectId       String?
  type            QuickCaptureType
  content         String           @db.Text
  audioUrl        String?
  durationSec     Int?
  syncedToProject Boolean          @default(false)
  recordingId     String?
  createdAt       DateTime         @default(now())

  user      User            @relation("UserQuickCaptures", fields: [userId], references: [id], onDelete: Cascade)
  project   Project?        @relation("ProjectQuickCaptures", fields: [projectId], references: [id], onDelete: Cascade)
  recording VoiceRecording? @relation(fields: [recordingId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@map("quick_captures")
}

// ============================================================================
// Developer API Platform Models
// ============================================================================

model ApiKey {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  /// SHA-256 of the full key (keys are 256-bit random, so no slow hash is needed).
  keyHash    String    @unique
  /// Display-only prefix, e.g. "bk_live_ab12".
  prefix     String
  scopes     String[] // allowlisted, e.g. ["projects:read", "documents:write"]
  createdBy  String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  rateLimit  Int       @default(600) // requests per minute (capped at the API boundary)
  createdAt  DateTime  @default(now())

  organization Organization @relation("OrgApiKeys", fields: [orgId], references: [id], onDelete: Cascade)
  usage        ApiUsage[]

  @@index([orgId])
  @@index([createdBy])
  @@map("api_keys")
}

model ApiUsage {
  id           String   @id @default(cuid())
  apiKeyId     String
  endpoint     String
  method       String
  statusCode   Int
  latencyMs    Int
  requestSize  Int?
  responseSize Int?
  ipAddress    String?
  userAgent    String?
  timestamp    DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([timestamp])
  @@index([endpoint])
  @@map("api_usage")
}

model Webhook {
  id                  String    @id @default(cuid())
  orgId               String
  name                String
  url                 String
  /// HMAC signing secret, encrypted at rest (shown to the user once on create/rotate).
  secretEncrypted     String    @db.Text
  events              String[] // e.g., ["synthesis.completed", "recommendation.generated"]
  active              Boolean   @default(true)
  createdBy           String
  lastTriggeredAt     DateTime?
  failureCount        Int       @default(0)
  consecutiveFailures Int       @default(0)
  /// Set when auto-disabled after too many consecutive failures.
  disabledAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization      @relation("OrgWebhooks", fields: [orgId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([orgId])
  @@index([active])
  @@index([createdAt])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?   @db.Text
  durationMs   Int?
  success      Boolean   @default(false)
  attemptCount Int       @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@index([event])
  @@map("webhook_deliveries")
}

// ============================================================================
// Platform foundations: job runs, domain events, token usage
// ============================================================================

enum JobStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum JobKind {
  RECOMMENDATIONS
  SENTIMENT
  CORRELATION
  KNOWLEDGE_EXTRACTION
  COMPETITIVE_SCAN
  COACHING
  HANDOFF_EXPORT
  WORKFLOW_MANUAL_RUN
  ROADMAP_IMPORT
  ANALYTICS_IMPORT
}

/// Generic tracking row for background work that has no natural row of its own.
/// The sweeper fails rows stuck in PENDING/PROCESSING past their deadline.
model JobRun {
  id           String    @id @default(cuid())
  kind         JobKind
  orgId        String
  projectId    String?
  createdById  String?
  status       JobStatus @default(PENDING)
  input        Json?
  output       Json?
  errorMessage String?   @db.Text
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, createdAt])
  @@index([status, updatedAt])
  @@map("job_runs")
}

/// Outbox of domain events. Every domain mutation records one; the event bus fans
/// it out to workflows, webhooks, notifications, coach and team activity.
model DomainEvent {
  id             String    @id @default(cuid())
  orgId          String
  projectId      String?
  /// e.g. "document.ready", "synthesis.completed", "recommendation.created"
  type           String
  payload        Json
  actorUserId    String?
  /// 0 for user/system-originated events; parent depth + 1 for workflow-originated ones.
  causationDepth Int       @default(0)
  /// Set once fan-out completes; the maintenance sweep re-dispatches stragglers.
  dispatchedAt   DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([type, createdAt])
  @@map("domain_events")
}

/// Persisted LLM/embedding token usage, attributed to org, project and feature.
/// Drives per-org budgets (plan entitlements) and cost reporting.
model TokenUsage {
  id               String   @id @default(cuid())
  orgId            String
  projectId        String?
  feature          String
  provider         String // "anthropic" | "openai" | "deepgram"
  model            String
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("token_usage")
}
