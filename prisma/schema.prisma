// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// User model - represents authenticated users via Clerk.
// Provisioned from the Clerk webhook (user.created/updated/deleted); email can be
// null until Clerk reports a primary address, and NULLs do not collide on @unique.
model User {
  id                String   @id @default(cuid())
  clerkId           String   @unique
  email             String?  @unique
  name              String?
  avatarUrl         String?
  /// Per-type notification channel preferences, e.g. {"COMMENT_MENTION": {"email": false}}
  notificationPrefs Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  projects           Project[]
  queries            Query[]
  orgMembers         OrgMember[]
  comments           Comment[]
  notifications      Notification[]
  decisionLogs       DecisionLog[]
  knowledgeQueries   KnowledgeQuery[]
  presentations      Presentation[]
  voiceRecordings    VoiceRecording[]    @relation("UserVoiceRecordings")
  quickCaptures      QuickCapture[]      @relation("UserQuickCaptures")
  orgInvitesSent     OrgInvite[]         @relation("OrgInvitesSent")
  teamActivities     TeamActivity[]
  integrations       Integration[]
  competitorProfiles CompetitorProfile[]
  competitorAlerts   CompetitorAlert[]
  coachInsights      CoachInsight[]
  coachSessions      CoachSession[]
  workflows          Workflow[]

  @@map("users")
}

// Project model - represents a product decision intelligence project.
// Every project belongs to an organization (a user's personal org by default);
// userId records the creator.
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents          Document[]
  chunks             Chunk[]
  jobRuns            JobRun[]
  syntheses          Synthesis[]
  recommendations    Recommendation[]
  queries            Query[]
  comments           Comment[]
  roadmaps           Roadmap[]
  analyticsImports   AnalyticsImport[]
  usageCorrelations  UsageCorrelation[]
  gapAnalyses        GapAnalysis[]
  decisionLogs       DecisionLog[]
  sentimentSnapshots SentimentSnapshot[]
  churnPredictions   ChurnPrediction[]
  sentimentAlerts    SentimentAlert[]
  knowledgeNodes     KnowledgeNode_Project[]
  voiceRecordings    VoiceRecording[]        @relation("ProjectVoiceRecordings")
  quickCaptures      QuickCapture[]          @relation("ProjectQuickCaptures")
  coachInsights      CoachInsight[]
  workflows          Workflow[]
  presentations      Presentation[]

  @@index([userId])
  @@index([orgId])
  @@index([createdAt])
  @@map("projects")
}

// Document model - represents ingested content (transcripts, tickets, notes, recordings).
// `type` is the semantic kind; `mimeType` drives parsing. Content is only ever read
// from `storageKey` in the application bucket (never from a client-supplied URL), or
// from `processedText` when the source already provided text (integrations, voice).
model Document {
  id                    String         @id @default(cuid())
  projectId             String
  title                 String
  type                  DocumentType
  source                DocumentSource @default(UPLOAD)
  mimeType              String?
  storageKey            String?
  fileSize              Int?
  /// Original URL for URL imports (fetched server-side through the SSRF-safe fetcher).
  sourceUrl             String?
  processedText         String?        @db.Text
  metadata              Json?
  status                DocumentStatus @default(PENDING)
  errorMessage          String?        @db.Text
  integrationId         String?
  externalId            String?
  createdById           String?
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integration    Integration?    @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  chunks         Chunk[]
  voiceRecording VoiceRecording?

  @@unique([integrationId, externalId])
  @@index([projectId, createdAt])
  @@index([status])
  @@map("documents")
}

enum DocumentSource {
  UPLOAD
  URL
  INTEGRATION
  VOICE
  QUICK_CAPTURE
}

enum DocumentType {
  TRANSCRIPT
  SUPPORT_TICKET
  NOTE
  CALL_RECORDING
  OTHER
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// Chunk model - processed document chunks with embeddings.
// `embedding` is written only via raw SQL (Prisma cannot write Unsupported types).
// `projectId` is denormalized so the ANN query filters without a join.
// The HNSW and full-text indexes live in the baseline migration SQL.
model Chunk {
  id             String                       @id @default(cuid())
  documentId     String
  projectId      String
  content        String                       @db.Text
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  /// Ordinal of the chunk within the document (0-based).
  position       Int
  /// Character offsets into the document's processedText.
  startOffset    Int?
  endOffset      Int?
  tokenCount     Int
  /// Speaker, page number, etc.
  metadata       Json?
  createdAt      DateTime                     @default(now())

  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations Citation[]

  @@unique([documentId, position])
  @@index([projectId])
  @@map("chunks")
}

// Synthesis model - represents analysis results (themes, pain points, feature requests)
model Synthesis {
  id             String          @id @default(cuid())
  projectId      String
  type           SynthesisType
  output         Json?
  modelUsed      String?
  status         SynthesisStatus @default(PENDING)
  errorMessage   String?         @db.Text
  createdById    String?
  /// Workflow causation depth of the event that requested this synthesis (0 for
  /// user/scheduled runs). Events the synthesis emits carry this depth, so the
  /// workflow loop guard covers RUN_SYNTHESIS chains.
  causationDepth Int             @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  themes          Theme[]
  recommendations Recommendation[]

  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("syntheses")
}

enum SynthesisType {
  THEMES
  PAIN_POINTS
  FEATURE_REQUESTS
  FULL
}

enum SynthesisStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// Theme model - represents extracted themes from synthesis
model Theme {
  id              String    @id @default(cuid())
  synthesisId     String
  name            String
  description     String    @db.Text
  sentiment       Sentiment
  confidenceScore Float
  createdAt       DateTime  @default(now())

  synthesis         Synthesis          @relation(fields: [synthesisId], references: [id], onDelete: Cascade)
  citations         Citation[]
  usageCorrelations UsageCorrelation[]

  @@index([synthesisId])
  @@map("themes")
}

enum Sentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  MIXED
}

// Citation model - represents evidence for themes from document chunks
model Citation {
  id             String @id @default(cuid())
  themeId        String
  chunkId        String
  quote          String @db.Text
  relevanceScore Float

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)
  chunk Chunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([themeId])
  @@index([chunkId])
  @@map("citations")
}

// Recommendation model - represents product recommendations
model Recommendation {
  id               String               @id @default(cuid())
  projectId        String
  synthesisId      String?
  title            String
  description      String               @db.Text
  impact           RecommendationImpact
  confidence       Float
  evidence         Json?
  status           RecommendationStatus @default(DRAFT)
  segments         String[]
  /// Generated feature brief, reused by the handoff exporter.
  brief            Json?
  briefGeneratedAt DateTime?
  /// JobRun that produced this recommendation (idempotent re-runs replace by run).
  runId            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  synthesis        Synthesis?        @relation(fields: [synthesisId], references: [id], onDelete: SetNull)
  outcomeTrackings OutcomeTracking[]
  decisionLogs     DecisionLog[]

  @@index([projectId])
  @@index([synthesisId])
  @@index([status])
  @@index([createdAt])
  @@map("recommendations")
}

enum RecommendationImpact {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationStatus {
  DRAFT
  ACCEPTED
  REJECTED
  IMPLEMENTED
}

// Query model - represents user questions and AI-generated answers
model Query {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  question  String
  answer    String?  @db.Text
  citations Json?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("queries")
}

// ============================================================================
// Organization & Team Models
// ============================================================================

enum OrgMemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum OrgPlan {
  FREE
  TEAM
  ENTERPRISE
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  /// Writable only through the server-side admin path (never via the org update API).
  plan       OrgPlan  @default(FREE)
  /// A user's personal workspace, created automatically at sign-up.
  isPersonal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members                   OrgMember[]
  invites                   OrgInvite[]
  domainEvents              DomainEvent[]
  tokenUsage                TokenUsage[]
  knowledgeMergeSuggestions KnowledgeMergeSuggestion[]
  projects                  Project[]
  teamActivities            TeamActivity[]
  integrations              Integration[]
  competitorProfiles        CompetitorProfile[]
  customAIConfigs           CustomAIConfig[]
  presentationTemplates     PresentationTemplate[]
  knowledgeEntities         KnowledgeEntity[]
  knowledgeQueries          KnowledgeQuery[]
  apiKeys                   ApiKey[]                   @relation("OrgApiKeys")
  webhooks                  Webhook[]                  @relation("OrgWebhooks")
  workflows                 Workflow[]

  @@index([slug])
  @@index([createdAt])
  @@map("organizations")
}

model OrgMember {
  id        String        @id @default(cuid())
  orgId     String
  userId    String
  role      OrgMemberRole @default(MEMBER)
  invitedAt DateTime      @default(now())
  joinedAt  DateTime?
  createdAt DateTime      @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("org_members")
}

/// Pending invitation to an organization. The raw token is emailed once; only its
/// SHA-256 hash is stored. Acceptance requires the signed-in user's email to match.
model OrgInvite {
  id          String        @id @default(cuid())
  orgId       String
  email       String
  role        OrgMemberRole @default(MEMBER)
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("OrgInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@map("org_invites")
}

model TeamActivity {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  projectId    String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  @@map("team_activities")
}

// ============================================================================
// Integration Hub Models
// ============================================================================

enum IntegrationProvider {
  INTERCOM
  ZENDESK
  GONG
  SLACK
  HUBSPOT
  AMPLITUDE
  MIXPANEL
  SALESFORCE
  LINEAR
  JIRA
  NOTION
  PRODUCTBOARD
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// One connection per provider per organization. `credentialsEncrypted` holds an
/// AES-256-GCM envelope (see src/lib/crypto.ts); plaintext credentials never touch the DB.
model Integration {
  id                    String              @id @default(cuid())
  orgId                 String
  /// User who connected the integration.
  userId                String
  /// Project that synced records are written into.
  projectId             String?
  provider              IntegrationProvider
  status                IntegrationStatus   @default(DISCONNECTED)
  credentialsEncrypted  String?             @db.Text
  credentialsKeyVersion Int?
  config                Json?
  /// Provider-specific incremental sync cursor.
  syncCursor            Json?
  lastSyncAt            DateTime?
  lastError             String?             @db.Text
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncs             IntegrationSync[]
  analyticsImports  AnalyticsImport[]
  documents         Document[]
  connectorInstalls ConnectorInstall[]

  @@unique([orgId, provider])
  @@index([userId])
  @@index([status])
  @@map("integrations")
}

model IntegrationSync {
  id               String     @id @default(cuid())
  integrationId    String
  status           SyncStatus @default(PENDING)
  recordsProcessed Int        @default(0)
  errorMessage     String?    @db.Text
  startedAt        DateTime   @default(now())
  completedAt      DateTime?

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, startedAt])
  @@index([status])
  @@map("integration_syncs")
}

// ============================================================================
// Competitive Intelligence Models
// ============================================================================

model CompetitorProfile {
  id            String    @id @default(cuid())
  orgId         String
  /// User who added the competitor.
  userId        String
  name          String
  website       String?
  description   String?   @db.Text
  /// Reference link only; review data is not scraped.
  g2Url         String?
  captureUrl    String?
  metadata      Json?
  lastScannedAt DateTime?
  lastScanError String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  updates      CompetitorUpdate[]
  alerts       CompetitorAlert[]

  @@index([orgId])
  @@index([userId])
  @@map("competitor_profiles")
}

enum CompetitorUpdateType {
  CHANGELOG
  REVIEW
  PRESS
  PRICING
  FEATURE
}

model CompetitorUpdate {
  id           String               @id @default(cuid())
  competitorId String
  type         CompetitorUpdateType
  title        String
  content      String               @db.Text
  sourceUrl    String?
  /// Hash of the source content, so re-scans don't duplicate updates.
  contentHash  String?
  /// True when entered manually (e.g. review insights, which are never scraped).
  isManual     Boolean              @default(false)
  sentiment    Sentiment            @default(NEUTRAL)
  detectedAt   DateTime             @default(now())
  createdAt    DateTime             @default(now())

  competitor CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, contentHash])
  @@index([competitorId])
  @@index([type])
  @@index([createdAt])
  @@map("competitor_updates")
}

model CompetitorAlert {
  id           String   @id @default(cuid())
  competitorId String
  userId       String
  type         String
  message      String   @db.Text
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())

  competitor CompetitorProfile @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([competitorId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("competitor_alerts")
}

// ============================================================================
// Roadmap Comparison Models
// ============================================================================

enum RoadmapSource {
  MANUAL
  CSV
  LINEAR
  JIRA
  NOTION
  PRODUCTBOARD
}

enum RoadmapItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoadmapItemPriority {
  P0
  P1
  P2
  P3
}

model Roadmap {
  id         String        @id @default(cuid())
  projectId  String
  name       String
  source     RoadmapSource @default(MANUAL)
  importedAt DateTime?
  metadata   Json?
  createdAt  DateTime      @default(now())

  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       RoadmapItem[]
  gapAnalyses GapAnalysis[]

  @@index([projectId])
  @@index([createdAt])
  @@map("roadmaps")
}

model RoadmapItem {
  id          String              @id @default(cuid())
  roadmapId   String
  title       String
  description String?             @db.Text
  status      RoadmapItemStatus   @default(PLANNED)
  priority    RoadmapItemPriority @default(P2)
  quarter     String?
  externalId  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, externalId])
  @@index([roadmapId])
  @@index([status])
  @@index([priority])
  @@map("roadmap_items")
}

model GapAnalysis {
  id              String    @id @default(cuid())
  projectId       String
  roadmapId       String
  synthesisId     String?
  status          JobStatus @default(PENDING)
  errorMessage    String?   @db.Text
  output          Json?
  evidenceDensity Json?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([roadmapId])
  @@index([createdAt])
  @@map("gap_analyses")
}

// ============================================================================
// Usage Data Overlay Models
// ============================================================================

enum AnalyticsSource {
  AMPLITUDE
  MIXPANEL
  POSTHOG
  CSV
}

model AnalyticsImport {
  id            String          @id @default(cuid())
  projectId     String
  integrationId String?
  source        AnalyticsSource
  data          Json
  importedAt    DateTime        @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([integrationId])
  @@index([importedAt])
  @@map("analytics_imports")
}

model UsageCorrelation {
  id               String   @id @default(cuid())
  projectId        String
  themeId          String
  featureName      String
  usageMetric      String
  correlationScore Float
  /// "positive" | "negative" | "neutral"
  direction        String   @default("neutral")
  insight          String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([projectId, themeId, featureName, usageMetric])
  @@index([projectId])
  @@index([themeId])
  @@index([createdAt])
  @@map("usage_correlations")
}

// ============================================================================
// Collaboration Models
// ============================================================================

enum CommentTargetType {
  THEME
  RECOMMENDATION
  SYNTHESIS
  DOCUMENT
  DECISION
}

enum NotificationType {
  COMMENT_MENTION
  COMMENT_REPLY
  SYNTHESIS_COMPLETE
  RECOMMENDATION_GENERATED
  INTEGRATION_SYNC
  COMPETITOR_ALERT
  SENTIMENT_ALERT
  OUTCOME_UPDATE
  ORG_INVITE
  WORKFLOW
  SYSTEM
}

model Comment {
  id         String            @id @default(cuid())
  userId     String
  projectId  String
  targetType CommentTargetType
  targetId   String
  content    String            @db.Text
  parentId   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([userId])
  @@index([projectId])
  @@index([targetType, targetId])
  @@map("comments")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String
  type         NotificationType
  title        String
  message      String           @db.Text
  resourceType String?
  resourceId   String?
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// ============================================================================
// Continuous Learning / Outcomes Models
// ============================================================================

enum OutcomeStatus {
  NOT_SHIPPED
  SHIPPED
  MEASURING
  MEASURED
}

model OutcomeTracking {
  id               String        @id @default(cuid())
  recommendationId String
  status           OutcomeStatus @default(NOT_SHIPPED)
  shippedAt        DateTime?
  metricName       String?
  baselineValue    Float?
  currentValue     Float?
  targetValue      Float?
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@unique([recommendationId])
  @@index([status])
  @@index([createdAt])
  @@map("outcome_trackings")
}

model DecisionLog {
  id               String   @id @default(cuid())
  projectId        String
  userId           String
  recommendationId String?
  decision         String   @db.Text
  reasoning        String   @db.Text
  evidence         Json?
  evidenceLinks    String[]
  outcome          String?
  createdAt        DateTime @default(now())

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("decision_logs")
}

// ============================================================================
// Custom AI Models
// ============================================================================

model CustomAIConfig {
  id                   String   @id @default(cuid())
  orgId                String
  taxonomy             Json?
  templates            Json?
  industryPreset       String?
  systemPromptOverride String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId])
  @@map("custom_ai_configs")
}

// ============================================================================
// AI PM Coach Models
// ============================================================================

enum CoachInsightType {
  FRAMEWORK_SUGGESTION
  PROCESS_IMPROVEMENT
  BEST_PRACTICE
  WARNING
  NUDGE
}

enum CoachInsightPriority {
  LOW
  MEDIUM
  HIGH
}

enum CoachInsightStatus {
  NEW
  SEEN
  ACTIONED
  DISMISSED
}

model CoachInsight {
  id        String               @id @default(cuid())
  userId    String
  projectId String?
  type      CoachInsightType
  title     String
  message   String               @db.Text
  evidence  Json?
  priority  CoachInsightPriority @default(MEDIUM)
  status    CoachInsightStatus   @default(NEW)
  createdAt DateTime             @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
  @@map("coach_insights")
}

model CoachSession {
  id              String   @id @default(cuid())
  userId          String
  context         Json?
  recommendations Json?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("coach_sessions")
}

