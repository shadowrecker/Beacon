enum WorkflowEvent {
  THEME_DETECTED
  RECOMMENDATION_GENERATED
  SYNTHESIS_COMPLETED
  COMPETITOR_UPDATE
  GAP_DETECTED
  CORRELATION_FOUND
  DOCUMENT_UPLOADED
}

enum WorkflowActionType {
  CREATE_BRIEF
  NOTIFY_SLACK
  NOTIFY_EMAIL
  ASSIGN_USER
  ADD_TO_ROADMAP
  EXPORT_TO_LINEAR
  EXPORT_TO_JIRA
  ALERT_TEAM
  RUN_SYNTHESIS
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}

model Workflow {
  id          String    @id @default(cuid())
  projectId   String
  orgId       String?
  name        String
  description String?   @db.Text
  trigger     Json // {event, conditions}
  actions     Json // [{type, params}]
  enabled     Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastRunAt   DateTime?
  runCount    Int       @default(0)

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  runs         WorkflowRun[]

  @@index([projectId])
  @@index([orgId])
  @@index([enabled])
  @@index([createdAt])
  @@map("workflows")
}

model WorkflowRun {
  id              String            @id @default(cuid())
  workflowId      String
  /// DomainEvent that triggered the run (null for manual runs). Unique per workflow
  /// so a redelivered event never runs the same workflow twice.
  eventId         String?
  /// How many workflow-triggered events deep this run is (loop guard).
  causationDepth  Int               @default(0)
  status          WorkflowRunStatus
  triggerData     Json?
  actionsExecuted Json?
  error           String?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, eventId])
  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@map("workflow_runs")
}

