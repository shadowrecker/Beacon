{
  "name": "beacon",
  "version": "0.1.0",
  "private": true,
  "description": "Beacon — AI-Powered Product Decision Intelligence Platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx scripts/run-evals.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "worker": "tsx src/workers/index.ts",
    "worker:build": "tsup",
    "worker:start": "node dist/workers/index.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-presigned-post": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "@clerk/nextjs": "^6.39.9",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@sentry/nextjs": "^11.17.0",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "^11.31.0",
    "@trpc/react-query": "^11.31.0",
    "@trpc/server": "^11.31.0",
    "bullmq": "^5.81.6",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.29",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.21.0",
    "posthog-js": "^1.454.2",
    "pptxgenjs": "^4.0.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "recharts": "^3.11.1",
    "superjson": "^2.2.1",
    "svix": "^2.11.1",
    "tailwind-merge": "^2.6.0",
    "undici": "^7.30.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^1.14.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "knip": "^5.40.0",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.7",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "next": {
      "postcss": "^8.5.33"
    }
  }
}
