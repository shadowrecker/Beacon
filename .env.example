# =============================================================================
# Beacon environment configuration
# Every variable the code reads is listed here; src/lib/env.ts validates them at
# boot (`assertServerEnv`). Production-required variables are marked [prod].
# =============================================================================

NODE_ENV=production
LOG_LEVEL=info
# Public base URL (invite links, OAuth callbacks, email links)
APP_URL=https://app.example.com

# ---- Core infrastructure ----------------------------------------------------
# Use a pooled connection (pgbouncer / RDS Proxy) with a connection limit.
DATABASE_URL=postgresql://beacon:password@db.internal:5432/beacon?connection_limit=10&pool_timeout=20
# rediss:// for TLS; Redis must use maxmemory-policy noeviction (BullMQ).
REDIS_URL=rediss://default:password@redis.internal:6379

# ---- Auth (Clerk) ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx
# [prod] Svix signing secret of the Clerk webhook endpoint /api/webhooks/clerk
CLERK_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/projects
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Server-side admin path (POST /api/admin/orgs/:id/plan). Unset disables it. >= 32 chars.
ADMIN_API_TOKEN=

# ---- AI ------------------------------------------------------------------------
# [prod]
ANTHROPIC_API_KEY=sk-ant-xxx
MODEL_DEFAULT=claude-opus-5-5
MODEL_BULK=claude-haiku-5-5
# [prod] Embeddings
OPENAI_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-3-large
# Audio/video transcription (voice capture, media uploads)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---- Object storage (S3 / Cloudflare R2 / MinIO) -------------------------------
STORAGE_DRIVER=s3
# [prod]
S3_BUCKET=beacon-uploads
S3_REGION=us-east-1
# Set for R2/MinIO; leave empty for AWS
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Browser-facing origin of the bucket (added to the CSP connect-src for uploads)
S3_PUBLIC_ORIGIN=https://beacon-uploads.s3.us-east-1.amazonaws.com
# Development only (STORAGE_DRIVER=local)
LOCAL_STORAGE_DIR=.devdata/storage
STORAGE_SIGNING_SECRET=

# ---- Encryption of secrets at rest ----------------------------------------------
# [prod] JSON map of key version -> base64 32-byte key. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding a new version and bumping CREDENTIALS_KEY_VERSION.
CREDENTIALS_ENCRYPTION_KEYS={"1":"REPLACE_WITH_BASE64_32_BYTES"}
CREDENTIALS_KEY_VERSION=1
# HMAC key for OAuth state parameters (falls back to CLERK_SECRET_KEY)
OAUTH_STATE_SECRET=

# ---- Email (Resend) --------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Beacon <notifications@example.com>"

# ---- Integrations: OAuth apps (leave empty to show a provider as "not configured")
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=
GONG_CLIENT_ID=
GONG_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# ---- Observability ------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- Worker process -------------------------------------------------------------------
WORKER_HEALTH_PORT=9464
SHUTDOWN_GRACE_MS=120000

# ---- docker-compose.yml only ----------------------------------------------------------
POSTGRES_USER=beacon
POSTGRES_PASSWORD=
POSTGRES_DB=beacon
REDIS_PASSWORD=
